# Copie este arquivo para ".env" (mesmo diretório do docker-compose.yml)
# e preencha com a fila SQS real criada na AWS (Etapa 2 do desafio) caso
# queira testar a integração ponta-a-ponta do analytics-service / SQS
# localmente. NUNCA faça commit do arquivo ".env" preenchido.

AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/SEU_ACCOUNT_ID/sua-fila
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Necessário apenas se estiver usando credenciais temporárias do AWS Academy
AWS_SESSION_TOKEN=
